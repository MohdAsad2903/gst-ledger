{
  "name": "gst-ledger",
  "version": "0.1.0",
  "description": "Internal GST purchase & sales register for A.M Machine Tool and Dies",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder --dir",
    "test": "vitest run",
    "lint": "npm run verify:core-pure && eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify:core-pure": "node -e \"const p=require('./packages/core/package.json'); const d=Object.keys(p.dependencies||{}); if(d.length){console.error('core has dependencies:',d);process.exit(1)} console.log('core is dependency-free')\""
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "build": {
    "appId": "com.ammachinetools.gstledger",
    "productName": "GST Ledger",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/better-sqlite3/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/better-sqlite3/**/*.node"
    ],
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.20.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.6"
  }
}
